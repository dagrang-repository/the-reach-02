{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-reach-02",
  "main": "src/index.js",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 * * * *", "0 */6 * * *"] },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "the-reach-02",
      "database_id": "1e7a426d-7496-4179-b014-c5c764534888"
    }
  ],
  "vars": {
    "BATCH_SIZE": "2",
    "BRIEFING_TTL_HOURS": "24",
    "PING_ALL_ENDPOINTS": "1",
    "REACH_PUBLIC_URL": "https://reach2.aplusz.app",
    "INDEXNOW_KEY": "414edb7f774b37ccfd3504951f3566eb",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "MAIL_FROM": "reach2@notify.aplusz.app",
    "INBOX_OWNER": "dagrang@gmail.com"
  },
  // the email hub (Cloudflare Email Service, notify.aplusz.app onboarded): used only when Email Routing refuses to
  // forward the owner's own PeerPush sign-in code (src/inbox.js). No destination restriction, like every hub sender.
  "send_email": [{ "name": "MAIL" }],
  "routes": [
    { "pattern": "reach2.aplusz.app", "custom_domain": true }
  ]
}
