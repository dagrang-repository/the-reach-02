{
  "name": "the-reach-02",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create the-reach-02",
    "db:migrate": "wrangler d1 execute the-reach-02 --file=./schema.sql --remote",
    "db:migrate:local": "wrangler d1 execute the-reach-02 --file=./schema.sql --local",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.34.0"
  }
}
