export function addSiteHtml() {
  return `<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Add a site &mdash; The AI Hill Top Lighthouse</title>
  <style>
    body{margin:0;font:16px/1.45 system-ui,sans-serif;background:#0f1a12;color:#e8f6e4}
    main{max-width:28rem;margin:0 auto;padding:2.5rem 1.25rem}
    label{display:block;margin:1rem 0 .35rem;font-size:.85rem;letter-spacing:.04em;text-transform:uppercase;color:#8dff9a}
    input{width:100%;box-sizing:border-box;padding:.7rem .8rem;border:1px solid #2d5a34;border-radius:12px;background:#15241a;color:#e8f6e4}
    button{margin-top:1.25rem;width:100%;padding:.85rem;border:0;border-radius:12px;background:#8dff9a;color:#0f1a12;font-weight:700;cursor:pointer}
    .hint{color:#9bb89a;font-size:.9rem}
    .note p{font-size:.82rem;line-height:1.55}
    #out,#pout{margin-top:1rem;white-space:pre-wrap}
    #done{display:none;border:1px solid #2d5a34;border-radius:16px;background:#15241a;padding:1.25rem 1.4rem;margin-top:1rem}
    #done h2{margin:.2rem 0 .6rem;color:#8dff9a}
    code{background:#15241a;border:1px solid #2d5a34;border-radius:6px;padding:.05rem .3rem;font-size:.8rem}
    a{color:#8dff9a}
  </style>
</head>
<body>
<main>
  <p><a href="/">&larr; doors</a></p>
  <h1>Add a site</h1>
  <div class="note" style="max-width:100%;margin:.7rem 0 0;opacity:.78">
    <p style="font-style:italic;margin:0 0 .8rem">The AI Hill Top Lighthouse is a shared directory that AIs can query when someone is looking for one of the sites in its network. It keeps a list of live products and pages, each with a name, a real URL, and a numbered door the assistant is directed to fetch. When a question comes in, the lighthouse matches that question to the right listing and hands back the live address so the assistant can send the person there.</p>
    <p style="margin:0 0 .6rem">If your site is added here, what this place does is put your site on the list the lighthouse readily feeds for AI assistants. Your site address, keywords, and a short description of how the site is built and prepared on the list. On a daily schedule that list is always kept refreshed (if you make changes to your site, new changes are auto-captured within 24 hours), with a markdown page, a matcher, and the atlas (paving the easiest path for AI models to find the answers a user is asking them for).</p>
    <p style="margin:0 0 .6rem">When someone asks an assistant something your site can answer, the assistant can look you up here and send them to your live URL.</p>
    <p style="margin:0">Your site stays yours. This one just starts pointing to it.</p>
  </div>
  <p class="hint" id="intro">Name and URL. The origin key is optional (if present, the daily cron wakes the search engines to keep your site content indexed).</p>
  <form id="f">
    <label for="name">Name</label>
    <input id="name" name="name" required placeholder="Site name">
    <label for="url">URL</label>
    <input id="url" name="url" required placeholder="https://example.com/">
    <label for="key">Origin key (optional)</label>
    <input id="key" name="key" placeholder="Origin key">
    <label for="token">Admin</label>
    <input id="token" name="token" required placeholder="Your admin token">
    <button type="submit">Add</button>
  </form>
  <div id="done">
    <h2 id="doneTitle"></h2>
    <p id="doneKey"></p>
    <p id="doneLinks"></p>
  </div>
  <div id="out" class="hint"></div>

  <hr style="border:0;border-top:1px solid #2d5a34;margin:2.75rem 0 1.5rem">

  <section id="paid">
    <h2 style="margin:0 0 .35rem">Add my site to this</h2>
    <p class="hint" style="margin:0 0 1rem">Listing slots are limited.</p>
    <p class="hint" id="paidIntro" style="margin:0 0 .5rem">&euro;200 / month through PayPal. Your door is created automatically the moment the subscription is confirmed. Cancel any time &mdash; the listing ends with it.</p>
    <form id="pf">
      <label for="pname">Site's full name</label>
      <input id="pname" required placeholder="Site name">
      <label for="purl">Full URL</label>
      <input id="purl" required placeholder="https://example.com/">
      <label for="pkey">Origin key (optional)</label>
      <input id="pkey" placeholder="Origin key">
      <details style="margin-top:.7rem">
        <summary class="hint" style="cursor:pointer">How to create an origin key on your site</summary>
        <p class="hint" style="margin:.5rem 0 0">Pick any 32-character hex string (letters a&ndash;f and digits 0&ndash;9). Save a plain text file named <code>yourkey.txt</code> at the root of your site, holding that key and nothing else, so it answers at <code>https://yoursite.com/yourkey.txt</code>. Paste the key above. Leave it empty and your door still goes live &mdash; add the key later and it is picked up on the next hourly pass.</p>
      </details>
      <button type="submit">Subscribe and add my site</button>
    </form>
    <p id="pfull" class="hint" style="display:none">Slots are currently full.</p>
    <div id="pout" class="hint"></div>
  </section>
</main>
<script>
document.getElementById("f").addEventListener("submit", async (e) => {
  e.preventDefault();
  const name = document.getElementById("name").value.trim();
  const url = document.getElementById("url").value.trim();
  const key = document.getElementById("key").value.trim();
  const token = document.getElementById("token").value.trim();
  const body = { name, url };
  if (key) body.key = key;
  const out = document.getElementById("out");
  out.textContent = "Saving...";
  try {
    const res = await fetch("/v1/sites", {
      method: "POST",
      headers: { "content-type": "application/json", authorization: "Bearer " + token },
      body: JSON.stringify(body),
    });
    const data = await res.json();
    if (!data.ok) { out.textContent = data.error || "failed"; return; }
    const n = (data.map && data.map.sites) || 0;
    const keyOk = !!(data.key_check && data.key_check.ok);
    document.getElementById("f").style.display = "none";
    document.getElementById("intro").style.display = "none";
    out.textContent = "";
    document.getElementById("doneTitle").textContent = (keyOk ? "Key green. " : "") + data.site.name + " successfully added" + (n ? " as door #" + n : "");
    document.getElementById("doneKey").textContent = keyOk ? "Origin key file is live (200)." : "Key not green yet - origin key file did not answer 200.";
    document.getElementById("doneLinks").innerHTML = (n ? '<a href="/#' + n + '">Open door #' + n + '</a> &middot; ' : '') + '<a href="/add">Add another site</a>';
    document.getElementById("done").style.display = "block";
  } catch (err) {
    out.textContent = String(err.message || err);
  }
});

fetch("/v1/slots").then((r) => r.json()).then((d) => {
  if (!d.open) {
    document.getElementById("pf").style.display = "none";
    document.getElementById("paidIntro").style.display = "none";
    document.getElementById("pfull").style.display = "block";
  }
}).catch(() => {});

document.getElementById("pf").addEventListener("submit", async (e) => {
  e.preventDefault();
  const pout = document.getElementById("pout");
  const body = {
    name: document.getElementById("pname").value.trim(),
    url: document.getElementById("purl").value.trim(),
    key: document.getElementById("pkey").value.trim(),
  };
  pout.textContent = "Opening PayPal...";
  try {
    const res = await fetch("/v1/join", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) });
    const data = await res.json();
    if (data.ok && data.approve) { window.location.href = data.approve; return; }
    pout.textContent = data.error || "try again shortly";
  } catch (err) {
    pout.textContent = String(err.message || err);
  }
});
</script>
</body>
</html>`;
}